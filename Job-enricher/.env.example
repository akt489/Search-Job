# Dedicated enricher DB role, never ingestion API credentials
DATABASE_URL=postgresql://enricher_role:PASSWORD@HOST:6543/postgres
DIRECT_DATABASE_URL=postgresql://enricher_role:PASSWORD@HOST:5432/postgres

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

BATCH_SIZE=5
POLL_INTERVAL_MS=60000
MAX_RETRIES=3
STALE_TIMEOUT_MS=600000
REQUEST_TIMEOUT_MS=30000
HEARTBEAT_INTERVAL_MS=300000
LOG_LEVEL=info
NODE_ENV=development
PORT=4030
